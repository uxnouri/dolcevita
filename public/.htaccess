# Dolce Vita Design — Apache config for Hostinger (static Astro build).
# Upload the *contents* of dist/ to public_html/. This file ships with the build.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the bare domain (no www).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# ---- Old WordPress / WooCommerce URLs → new pages (keeps Google rankings) ----
# The old WooCommerce products were the theme demo catalogue; none exist any more → shop.
RewriteRule ^product/ /boutique/ [R=301,L]
# Old WooCommerce categories → the client's categories.
RewriteRule ^product-category/(?:[^/]+/)*(?:sofas|long|double|single|modern|handing|living-room)/?$ /categorie/canapes/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*armchair/?$ /categorie/fauteuils/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*chairs/?$ /categorie/chaises/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*stool/?$ /categorie/poufs/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*(?:tables|meeting-tables)/?$ /categorie/tables-basses/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*dining-room/?$ /categorie/tables-a-manger/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*(?:cabinets|wardrobes)/?$ /categorie/commodes/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*bedroom/?$ /categorie/lits/ [R=301,L]
RewriteRule ^product-category/ /boutique/ [R=301,L]
RewriteRule ^(?:product-brand|product-tag)/ /boutique/ [R=301,L]
RewriteRule ^(?:shop|shop-2)/?$ /boutique/ [R=301,L]
RewriteRule ^(?:cart|cart-2|checkout|checkout-2|my-account|my-account-2|wishlist|compare|order-tracking)(?:/.*)?$ /boutique/ [R=301,L]
RewriteRule ^about-us-modern/?$ /a-propos/ [R=301,L]
RewriteRule ^contact-us-modern/?$ /contact/ [R=301,L]
RewriteRule ^(?:home-13-modern|coming-soon-modern|header-demo-light|footer-home-13-page|hello-world|page-404)/?$ / [R=301,L]
RewriteRule ^(?:feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^(?:wp-sitemap\.xml|sitemap_index\.xml|sitemap\.xml)$ /sitemap-index.xml [R=301,L]

# Renamed products (old slug → new slug).
RewriteRule ^((?:en/|ar/)?(?:produit|product))/table-basse-beton/?$ /$1/table-basse-sculpturale-travertin/ [R=301,L]
RewriteRule ^((?:en/|ar/)?(?:produit|product))/(?:table-basse-noyer-organique|table-basse-travertin-minimaliste|table-basse-travertin-beige)/?$ /$1/table-basse-rectangulaire-travertin/ [R=301,L]
RewriteRule ^((?:en/|ar/)?(?:produit|product))/table-basse-ovale-travertin-creme/?$ /$1/table-basse-ovale-travertin-beige/ [R=301,L]
RewriteRule ^((?:en/|ar/)?(?:produit|product))/tables-gigognes-noyer/?$ /$1/tables-gigognes-rondes-noyer/ [R=301,L]

# Journal: the old theme articles (at the site root on WordPress, then under /blog/) were rewritten
# as new articles with new addresses. Each old address goes straight to its replacement.
RewriteRule ^(?:blog/)?transform-your-home-scandinavian-style-ideas-with-a-luxury-touch/?$ /blog/table-basse-travertin-maroc/ [R=301,L]
RewriteRule ^(en|ar)/blog/transform-your-home-scandinavian-style-ideas-with-a-luxury-touch/?$ /$1/blog/table-basse-travertin-maroc/ [R=301,L]
RewriteRule ^(?:blog/)?modular-kitchen-design-in-calgary-canada-roots-cabinet/?$ /blog/conception-3d-interieur-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/modular-kitchen-design-in-calgary-canada-roots-cabinet/?$ /$1/blog/conception-3d-interieur-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?create-your-modern-bohemian-home-office/?$ /blog/couleurs-interieur-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/create-your-modern-bohemian-home-office/?$ /$1/blog/couleurs-interieur-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?pop-border-designs-the-unexpected-twist-your-home-interiors-need/?$ /blog/decoration-appartement-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/pop-border-designs-the-unexpected-twist-your-home-interiors-need/?$ /$1/blog/decoration-appartement-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?5-stunning-bed-designs-make-a-cosy-bedroom-dreams-come-alive/?$ /blog/chambre-cocon-lit-tete-de-lit/ [R=301,L]
RewriteRule ^(en|ar)/blog/5-stunning-bed-designs-make-a-cosy-bedroom-dreams-come-alive/?$ /$1/blog/chambre-cocon-lit-tete-de-lit/ [R=301,L]
RewriteRule ^(?:blog/)?style-marries-storage-10-stunning-living-room-almirah-designs/?$ /blog/amenager-riad-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/style-marries-storage-10-stunning-living-room-almirah-designs/?$ /$1/blog/amenager-riad-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?the-ultimate-guide-to-designing-your-ideal-kitchen-10-key-essentials/?$ /blog/meubler-location-saisonniere-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/the-ultimate-guide-to-designing-your-ideal-kitchen-10-key-essentials/?$ /$1/blog/meubler-location-saisonniere-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?bring-your-kitchen-to-life-with-these-kitchen-colour-trends-in-2025/?$ /blog/chaises-salle-a-manger-guide/ [R=301,L]
RewriteRule ^(en|ar)/blog/bring-your-kitchen-to-life-with-these-kitchen-colour-trends-in-2025/?$ /$1/blog/chaises-salle-a-manger-guide/ [R=301,L]
RewriteRule ^(?:blog/)?10-stunning-glass-shelving-ideas-to-elevate-your-home-decor/?$ /blog/amenagement-interieur-cle-en-main-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/10-stunning-glass-shelving-ideas-to-elevate-your-home-decor/?$ /$1/blog/amenagement-interieur-cle-en-main-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?5-bhk-house-designs-that-turn-heads-and-win-hearts/?$ /blog/miroir-decoratif-agrandir-piece/ [R=301,L]
RewriteRule ^(en|ar)/blog/5-bhk-house-designs-that-turn-heads-and-win-hearts/?$ /$1/blog/miroir-decoratif-agrandir-piece/ [R=301,L]
RewriteRule ^(?:blog/)?from-walls-to-ceilings-pop-moulding-ideas-for-a-simple-yet-stylish-home/?$ /blog/salon-marocain-contemporain/ [R=301,L]
RewriteRule ^(en|ar)/blog/from-walls-to-ceilings-pop-moulding-ideas-for-a-simple-yet-stylish-home/?$ /$1/blog/salon-marocain-contemporain/ [R=301,L]
RewriteRule ^(?:blog/)?find-the-hue-thats-perfect-for-you-drawing-room-colour-ideas/?$ /blog/meubler-villa-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/find-the-hue-thats-perfect-for-you-drawing-room-colour-ideas/?$ /$1/blog/meubler-villa-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?vibrant-visions-captivating-living-room-colour-trends/?$ /blog/tissu-boucle-tendance-entretien/ [R=301,L]
RewriteRule ^(en|ar)/blog/vibrant-visions-captivating-living-room-colour-trends/?$ /$1/blog/tissu-boucle-tendance-entretien/ [R=301,L]
RewriteRule ^(?:blog/)?10-living-room-interior-design-trends-to-transform-your-space/?$ /blog/canape-sur-mesure-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/10-living-room-interior-design-trends-to-transform-your-space/?$ /$1/blog/canape-sur-mesure-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?we-use-only-the-best-and-newest-woodworking-machines-available-on-the-market/?$ /blog/mobilier-sur-mesure-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/we-use-only-the-best-and-newest-woodworking-machines-available-on-the-market/?$ /$1/blog/mobilier-sur-mesure-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?we-use-the-highest-quality-materials-hard-to-find-on-the-market-to-make-our-furniture-unique/?$ /blog/mobilier-climat-marrakech/ [R=301,L]
RewriteRule ^(en|ar)/blog/we-use-the-highest-quality-materials-hard-to-find-on-the-market-to-make-our-furniture-unique/?$ /$1/blog/mobilier-climat-marrakech/ [R=301,L]
RewriteRule ^(?:blog/)?2-2/?$ /blog/entretien-meubles-bois-tissu-travertin/ [R=301,L]
RewriteRule ^(en|ar)/blog/2-2/?$ /$1/blog/entretien-meubles-bois-tissu-travertin/ [R=301,L]
RewriteRule ^(?:blog/)?the-ultimate-guide-to-bathroom-vanity-and-sink-types-and-styles/?$ /blog/petits-espaces-meubles-malins/ [R=301,L]
RewriteRule ^(en|ar)/blog/the-ultimate-guide-to-bathroom-vanity-and-sink-types-and-styles/?$ /$1/blog/petits-espaces-meubles-malins/ [R=301,L]
# Add the trailing slash to page URLs (all pages are folder/index.html).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"
  # Files outside /_astro/ keep the same name when they change (share images, icons, logos): one week.
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/avif "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # Content-hashed build files get a year: see /_astro/.htaccess.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>
