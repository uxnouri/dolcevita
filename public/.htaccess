# Dolce Vita Design — Apache config for Hostinger (static Astro build).
# Upload the *contents* of dist/ to public_html/. This file ships with the build.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the bare domain (no www).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# ---- Old WordPress / WooCommerce URLs → new pages (keeps Google rankings) ----
# Products that are no longer sold (not in the client's 12 categories) → shop.
RewriteRule ^(?:product|produit|en/product|ar/product)/(?:bess-decorative-throw-pillow|arlomore-table-lamp|natural-linen-pillow|modern-ceramic-table-lamp|metal-engrace-table-lamp|rita-table-lamp-rta|gentoo-rectangular-desk|promenade-white-table-lamp)/?$ /boutique/ [R=301,L]
RewriteRule ^(?:product|produit|en/product|ar/product)/(?:cordoba-large-table-lamp|currey-co-lilou-table-lamp|arianna-table-lamp|prestige-white-lamp|straight-panel-end-desk|table-lamp-belaya-ceramic|bathroom-vanity-vessel-sink|burlap-fabric-rolled)/?$ /boutique/ [R=301,L]
RewriteRule ^(?:product|produit|en/product|ar/product)/(?:home-office-modular-desk|tall-wooden-bedroom-armoires|traditional-ivory-table-lamp|rechargeable-table-lamp|modern-wooden-large-wardrobe|large-wardrobe-closet|reading-bed-side-lamp|touch-bedside-table-lamp)/?$ /boutique/ [R=301,L]
RewriteRule ^(?:product|produit|en/product|ar/product)/(?:farmhouse-rustic-lamp|dimmable-nightstand-lamp|modern-tapered-fabric-light|traditional-lamp-for-bedroom|luxe-sofa-accessories|cabinet-cupboard-with-4-doors|modern-white-desk-lamp|touch-dimmable-desk-lamp)/?$ /boutique/ [R=301,L]
RewriteRule ^(?:product|produit|en/product|ar/product)/(?:fine-art-decoration-lamp|traditional-retro-desk-lamp|farmhouse-table-lamps)/?$ /boutique/ [R=301,L]
RewriteRule ^product/([^/]+)/?$ /produit/$1/ [R=301,L]
# Old WooCommerce categories → the client's categories.
RewriteRule ^product-category/(?:[^/]+/)*(?:sofas|long|double|single|modern|handing|living-room)/?$ /categorie/canapes/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*armchair/?$ /categorie/fauteuils/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*chairs/?$ /categorie/chaises/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*stool/?$ /categorie/poufs/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*(?:tables|meeting-tables|dining-room)/?$ /categorie/tables-a-manger/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*(?:cabinets|wardrobes)/?$ /categorie/commodes/ [R=301,L]
RewriteRule ^product-category/(?:[^/]+/)*bedroom/?$ /categorie/lits/ [R=301,L]
RewriteRule ^product-category/ /boutique/ [R=301,L]
RewriteRule ^(?:product-brand|product-tag)/ /boutique/ [R=301,L]
RewriteRule ^(?:shop|shop-2)/?$ /boutique/ [R=301,L]
RewriteRule ^(?:cart|cart-2|checkout|checkout-2|my-account|my-account-2|wishlist|compare|order-tracking)(?:/.*)?$ /boutique/ [R=301,L]
RewriteRule ^about-us-modern/?$ /a-propos/ [R=301,L]
RewriteRule ^contact-us-modern/?$ /contact/ [R=301,L]
RewriteRule ^(?:home-13-modern|coming-soon-modern|header-demo-light|footer-home-13-page|hello-world|page-404)/?$ / [R=301,L]
RewriteRule ^(?:feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^(?:wp-sitemap\.xml|sitemap_index\.xml|sitemap\.xml)$ /sitemap-index.xml [R=301,L]

# Blog posts used to live at the site root.
RewriteRule ^transform-your-home-scandinavian-style-ideas-with-a-luxury-touch/?$ /blog/transform-your-home-scandinavian-style-ideas-with-a-luxury-touch/ [R=301,L]
RewriteRule ^modular-kitchen-design-in-calgary-canada-roots-cabinet/?$ /blog/modular-kitchen-design-in-calgary-canada-roots-cabinet/ [R=301,L]
RewriteRule ^create-your-modern-bohemian-home-office/?$ /blog/create-your-modern-bohemian-home-office/ [R=301,L]
RewriteRule ^pop-border-designs-the-unexpected-twist-your-home-interiors-need/?$ /blog/pop-border-designs-the-unexpected-twist-your-home-interiors-need/ [R=301,L]
RewriteRule ^5-stunning-bed-designs-make-a-cosy-bedroom-dreams-come-alive/?$ /blog/5-stunning-bed-designs-make-a-cosy-bedroom-dreams-come-alive/ [R=301,L]
RewriteRule ^style-marries-storage-10-stunning-living-room-almirah-designs/?$ /blog/style-marries-storage-10-stunning-living-room-almirah-designs/ [R=301,L]
RewriteRule ^the-ultimate-guide-to-designing-your-ideal-kitchen-10-key-essentials/?$ /blog/the-ultimate-guide-to-designing-your-ideal-kitchen-10-key-essentials/ [R=301,L]
RewriteRule ^bring-your-kitchen-to-life-with-these-kitchen-colour-trends-in-2025/?$ /blog/bring-your-kitchen-to-life-with-these-kitchen-colour-trends-in-2025/ [R=301,L]
RewriteRule ^10-stunning-glass-shelving-ideas-to-elevate-your-home-decor/?$ /blog/10-stunning-glass-shelving-ideas-to-elevate-your-home-decor/ [R=301,L]
RewriteRule ^5-bhk-house-designs-that-turn-heads-and-win-hearts/?$ /blog/5-bhk-house-designs-that-turn-heads-and-win-hearts/ [R=301,L]
RewriteRule ^from-walls-to-ceilings-pop-moulding-ideas-for-a-simple-yet-stylish-home/?$ /blog/from-walls-to-ceilings-pop-moulding-ideas-for-a-simple-yet-stylish-home/ [R=301,L]
RewriteRule ^find-the-hue-thats-perfect-for-you-drawing-room-colour-ideas/?$ /blog/find-the-hue-thats-perfect-for-you-drawing-room-colour-ideas/ [R=301,L]
RewriteRule ^vibrant-visions-captivating-living-room-colour-trends/?$ /blog/vibrant-visions-captivating-living-room-colour-trends/ [R=301,L]
RewriteRule ^10-living-room-interior-design-trends-to-transform-your-space/?$ /blog/10-living-room-interior-design-trends-to-transform-your-space/ [R=301,L]
RewriteRule ^we-use-only-the-best-and-newest-woodworking-machines-available-on-the-market/?$ /blog/we-use-only-the-best-and-newest-woodworking-machines-available-on-the-market/ [R=301,L]
RewriteRule ^we-use-the-highest-quality-materials-hard-to-find-on-the-market-to-make-our-furniture-unique/?$ /blog/we-use-the-highest-quality-materials-hard-to-find-on-the-market-to-make-our-furniture-unique/ [R=301,L]
RewriteRule ^2-2/?$ /blog/2-2/ [R=301,L]
RewriteRule ^the-ultimate-guide-to-bathroom-vanity-and-sink-types-and-styles/?$ /blog/the-ultimate-guide-to-bathroom-vanity-and-sink-types-and-styles/ [R=301,L]
# Add the trailing slash to page URLs (all pages are folder/index.html).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Build assets are content-hashed (/_astro/…): cache for a year.
  <FilesMatch "\.(js|css|woff2|webp|avif|jpe?g|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>
