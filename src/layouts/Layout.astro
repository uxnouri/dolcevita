---
import "../styles/global.css";
import manrope from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import cairo from "@fontsource-variable/cairo/files/cairo-arabic-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { OG_SIZE, SITE, SITE_IDS } from "../lib/site";

import { LANGS, LANG_META, useT, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** URL of this same page in every language (see `alternates()` in i18n). */
  alternates: Record<Lang, string>;
  /** Share image: a 1200×630 JPEG (see src/lib/og.ts). Defaults to the brand image. */
  image?: string;
  /** Open Graph type: "product" on product pages, "article" on journal posts. */
  ogType?: "website" | "product" | "article";
  /** Schema.org objects to embed as JSON-LD. */
  schema?: object[];
  noindex?: boolean;
}

const { lang, title, description, alternates, image, ogType = "website", schema = [], noindex = false } = Astro.props;
const t = useT(lang);
// Google shows about 60 characters: long product names keep the whole name rather than the brand suffix.
const fullTitle = !title ? `${SITE.name} · ${t("hero.eyebrow")}` : title.length > 45 ? title : `${title} · ${SITE.name}`;
const desc = description ?? t("meta.description");
const canonical = new URL(Astro.url.pathname, Astro.site);
const meta = LANG_META[lang];
const hreflang = LANGS.map((l) => ({ lang: l, href: new URL(alternates[l], Astro.site) }));
const ogImage = new URL(image ?? "/og.jpg", Astro.site);
const home = new URL(alternates[lang], Astro.site).href;

// The business, described once with a stable @id so product, service and article data can point to it.
const STORE_ID = SITE_IDS.store;
const store = {
  "@context": "https://schema.org",
  "@type": "FurnitureStore",
  "@id": STORE_ID,
  name: SITE.name,
  url: SITE.url,
  description: t("meta.description"),
  slogan: t("hero.title"),
  email: SITE.email,
  telephone: SITE.phones.map((p) => p.replace(/\s/g, "")),
  image: new URL("/og.jpg", Astro.site).href,
  logo: new URL("/icon-512.png", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    postalCode: SITE.address.postalCode,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  geo: { "@type": "GeoCoordinates", latitude: SITE.geo.latitude, longitude: SITE.geo.longitude },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: SITE.hours.days, opens: SITE.hours.opens, closes: SITE.hours.closes },
  ],
  hasMap: SITE.googleProfile,
  areaServed: [
    { "@type": "City", name: "Marrakech" },
    { "@type": "Country", name: "Morocco" },
  ],
  currenciesAccepted: SITE.currency,
  knowsLanguage: ["fr", "ar", "en"],
  sameAs: [SITE.instagram, SITE.facebook, SITE.tiktok, SITE.googleProfile].filter(Boolean),
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE_IDS.website,
  name: SITE.name,
  url: home,
  inLanguage: meta.locale,
  publisher: { "@id": STORE_ID },
};
---

<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonical} />
    {hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    {lang === "ar" && <link rel="preload" href={cairo} as="font" type="font/woff2" crossorigin />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta property="og:locale" content={meta.og} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title ?? SITE.name} />

    <script type="application/ld+json" set:html={JSON.stringify([store, website, ...schema])} />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">
      {t("nav.skip")}
    </a>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CartDrawer lang={lang} />

    <script>
      import "../scripts/ui";
      import "../scripts/cart";
    </script>
  </body>
</html>
