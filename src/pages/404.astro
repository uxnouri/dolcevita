---
import Layout from "../layouts/Layout.astro";
import { alternates, path, useT } from "../i18n";

const t = useT("fr");
const en = useT("en");
const ar = useT("ar");
---

<Layout lang="fr" title={t("404.title")} alternates={alternates("home")} noindex>
  <section class="container-site grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="text-[7rem] leading-none font-bold tracking-tighter text-stone sm:text-[10rem]">404</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{t("404.title")}</h1>
      <p class="mt-3 text-muted">{t("404.text")}</p>
      <p class="mt-1 text-sm text-muted" lang="en">{en("404.text")}</p>
      <p class="mt-1 text-sm text-muted" lang="ar" dir="rtl">{ar("404.text")}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={path("fr", "home")} class="btn-primary">{t("404.cta")}</a>
        <a href={path("fr", "shop")} class="btn-ghost">{t("nav.shop")}</a>
      </div>
    </div>
  </section>
</Layout>
