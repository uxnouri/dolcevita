---
/**
 * DEV-ONLY stress page (break-ui). Generated by the dev server only; production builds get no pages.
 * Open /dev/demo/, /dev/worst/, /dev/one/, /dev/empty/ and flip the toggle at the bottom.
 */
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { alternates, useT } from "../../i18n";
import { products } from "../../lib/catalog";
import { WORST } from "../../lib/fixtures";
import { productCount } from "../../lib/plural";

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return ["demo", "worst", "one", "empty"].map((state) => ({ params: { state } }));
}

const state = Astro.params.state as "demo" | "worst" | "one" | "empty";
const lang = (Astro.url.searchParams.get("lang") ?? "fr") as "fr" | "en" | "ar";
const t = useT(lang);
const data = { demo: products.slice(0, 8), worst: WORST, one: WORST.slice(2, 3), empty: [] }[state];
---

<Layout lang={lang} title={`Stress: ${state}`} alternates={alternates("home")} noindex>
  <div class="container-site py-10">
    <p class="text-sm text-muted tabular-nums" data-count>{productCount(data.length, lang)}</p>
    <div class="mt-6 grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-5 md:grid-cols-3 lg:grid-cols-4">
      {data.map((p) => <ProductCard product={p} lang={lang} />)}
    </div>
    {data.length === 0 && <p class="py-20 text-center text-muted">{t("shop.empty")}</p>}
  </div>
  <nav style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:60;display:flex;gap:2px;padding:3px;border-radius:999px;background:#e5e5e5;font:13px system-ui">
    {["demo", "worst", "one", "empty"].map((s) => (
      <a href={`/dev/${s}/?lang=${lang}`} style={`padding:6px 12px;border-radius:999px;color:#111;text-decoration:none;${s === state ? "background:#fff" : ""}`}>{s === "demo" ? "Demo data" : s === "worst" ? "Worst case" : s === "one" ? "One" : "Empty"}</a>
    ))}
  </nav>
</Layout>
