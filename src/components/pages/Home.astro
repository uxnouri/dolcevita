---
import { Image } from "astro:assets";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Hammer from "@lucide/astro/icons/hammer";
import Leaf from "@lucide/astro/icons/leaf";
import Ruler from "@lucide/astro/icons/ruler";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import MapPin from "@lucide/astro/icons/map-pin";
import Layout from "../../layouts/Layout.astro";
import ProductRail from "../ProductRail.astro";
import PostCard from "../PostCard.astro";
import { alternates, path, useT, type Lang } from "../../i18n";
import { bestsellers, latest, siteImage, topCategories } from "../../lib/catalog";
import CategoryIcon from "../CategoryIcon.astro";
import { SERVICES } from "../../lib/services";
import { posts } from "../../lib/blog";
import { SITE } from "../../lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const hero = siteImage("revslider-home-12-modern-slide1-demo121.jpg");

const bannersTop = [
  { img: "revslider-home-12-modern-slide2-demo121.jpg", label: t("banner.living"), href: path(lang, "category", "canapes") },
  { img: "2025-04-modern-banner4.jpg", label: t("banner.seating"), href: path(lang, "category", "fauteuils") },
];
const services = SERVICES[lang];

const promises = [
  { icon: Hammer, title: t("promise.craft.title"), text: t("promise.craft.text") },
  { icon: Leaf, title: t("promise.eco.title"), text: t("promise.eco.text") },
  { icon: Ruler, title: t("promise.custom.title"), text: t("promise.custom.text") },
  { icon: ShieldCheck, title: t("promise.durable.title"), text: t("promise.durable.text") },
];
---

<Layout lang={lang} alternates={alternates("home")}>
  <!-- Hero -->
  <section class="container-site pt-2 sm:pt-4">
    <div class="hero relative isolate flex min-h-[min(82svh,46rem)] flex-col justify-end overflow-hidden rounded-[1.75rem] bg-stone sm:min-h-[min(86svh,52rem)] sm:rounded-[2.25rem]">
      <Image
        src={hero}
        alt=""
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1408px) 1328px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-img absolute inset-0 -z-10 size-full object-cover object-[62%_center]"
      />
      <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/70 via-black/25 to-black/0 sm:bg-linear-to-tr sm:from-black/65 sm:via-black/20"></div>

      <div class="max-w-3xl p-6 pb-8 text-white sm:p-12 lg:p-16">
        <p class="hero-in text-xs font-semibold tracking-[0.16em] text-white/80 uppercase" style="--d:0">{t("hero.eyebrow")}</p>
        <h1 class="hero-in mt-4 text-[clamp(3rem,9vw,6.25rem)] leading-[0.95] font-bold tracking-[-0.045em]" style="--d:1">
          {t("hero.title")}
        </h1>
        <p class="hero-in mt-5 max-w-md text-base leading-relaxed text-white/85 sm:text-lg" style="--d:2">{t("hero.lead")}</p>
        <div class="hero-in mt-8 flex flex-wrap gap-3" style="--d:3">
          <a href={path(lang, "shop")} class="btn-light">
            {t("hero.cta")}
            <ArrowRight size={18} class="flip-rtl" />
          </a>
          <a href={path(lang, "contact")} class="btn border border-white/40 text-white backdrop-blur-sm hover:bg-white/10">
            {t("hero.secondary")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our offer -->
  <section class="mt-10 sm:mt-14" aria-labelledby="offer-title">
    <div class="container-site">
      <h2 id="offer-title" class="eyebrow">{t("home.offer")}</h2>
    </div>
    <ul class="rail container-site mt-4 sm:grid sm:grid-cols-4 sm:overflow-visible lg:grid-cols-6">
      {
        topCategories.map((c, i) => (
          <li class="w-[34%] shrink-0 sm:w-auto" data-reveal style={`--i:${i % 6}`}>
            <a
              href={path(lang, "category", c.slug)}
              class="pressable group flex h-full flex-col items-center gap-3 rounded-2xl bg-sand px-3 pt-5 pb-4 text-center hover:bg-stone"
            >
              <CategoryIcon
                slug={c.slug}
                size={36}
                class="text-brand transition-transform duration-300 ease-(--ease-out) group-hover:-translate-y-0.5"
              />
              <span class="text-[15px] leading-tight font-semibold">{c.label[lang]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Editorial banners -->
  <section class="container-site mt-6 grid gap-3 sm:mt-8 sm:grid-cols-2 sm:gap-4">
    {
      bannersTop.map((b, i) => (
        <a href={b.href} class="banner group" data-reveal style={`--i:${i}`}>
          <Image src={siteImage(b.img)} alt="" widths={[480, 720, 960, 1328]} sizes="(min-width: 640px) 50vw, 100vw" class="banner-img aspect-[4/3] sm:aspect-[5/4]" />
          <span class="banner-label">
            {b.label}
            <span class="banner-cta">{t("home.more")}<ArrowUpRight size={16} class="flip-rtl" /></span>
          </span>
        </a>
      ))
    }
  </section>

  <ProductRail lang={lang} id="latest" title={t("home.latest")} lead={t("home.latestLead")} products={latest} />

  <!-- Turnkey services -->
  <section class="container-site mt-20 sm:mt-28" aria-labelledby="services-title">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
      <div class="max-w-2xl">
        <p class="eyebrow">{services.eyebrow}</p>
        <h2 id="services-title" class="mt-2 text-3xl font-bold sm:text-4xl">{services.title}</h2>
      </div>
      <a href={path(lang, "services")} class="btn-ghost shrink-0 self-start sm:self-auto">
        {t("home.services.cta")}
        <ArrowRight size={18} class="flip-rtl" />
      </a>
    </div>
    <div class="mt-8 grid gap-3 sm:grid-cols-3 sm:gap-4">
      {
        services.services.map((s, i) => (
          <a href={`${path(lang, "services")}#${s.id}`} class="banner group" data-reveal style={`--i:${i}`}>
            <Image src={siteImage(s.image)} alt="" widths={[480, 720, 960]} sizes="(min-width: 640px) 33vw, 100vw" class="banner-img aspect-[4/3] sm:aspect-[4/5]" />
            <span class="banner-label">
              <span><span class="block text-sm font-bold text-white/70 tabular-nums">0{i + 1}</span>{s.title}</span>
              <span class="banner-cta">{t("home.more")}<ArrowUpRight size={16} class="flip-rtl" /></span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <ProductRail lang={lang} id="bestsellers" title={t("home.best")} lead={t("home.bestLead")} products={bestsellers} />

  <!-- Promise -->
  <section class="container-site mt-20 sm:mt-28" aria-labelledby="promise-title">
    <div class="rounded-[1.75rem] bg-sand px-6 py-12 sm:rounded-[2.25rem] sm:px-12 sm:py-16">
      <h2 id="promise-title" class="text-3xl font-bold sm:text-4xl">{t("home.promise")}</h2>
      <ul class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          promises.map((p, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="grid size-12 place-items-center rounded-full bg-brand text-white">
                <p.icon size={22} stroke-width={1.75} />
              </span>
              <h3 class="mt-5 text-lg font-bold tracking-tight">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Showroom -->
  <section class="container-site mt-20 grid items-center gap-8 sm:mt-28 lg:grid-cols-2 lg:gap-16">
    <div class="overflow-hidden rounded-[1.75rem] sm:rounded-[2.25rem]" data-reveal>
      <Image src={siteImage("revslider-home-12-modern-slide3-demo121.jpg")} alt="" widths={[480, 720, 1000, 1328]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] size-full object-cover" />
    </div>
    <div data-reveal style="--i:1">
      <p class="eyebrow">{t("footer.visit")} · {SITE.address.city}</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-5xl">{t("visit.title")}</h2>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">{t("visit.text")}</p>
      <p class="mt-6 flex items-start gap-3 font-medium">
        <MapPin size={20} class="mt-0.5 shrink-0 text-brand" />
        {SITE.address.street}, {SITE.address.city}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={SITE.mapUrl} target="_blank" rel="noopener" class="btn-primary">{t("visit.cta")}<ArrowUpRight size={18} class="flip-rtl" /></a>
        <a href={path(lang, "contact")} class="btn-ghost">{t("nav.contact")}</a>
      </div>
    </div>
  </section>

  <!-- Journal -->
  <section class="container-site mt-20 sm:mt-28" aria-labelledby="journal-title">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 id="journal-title" class="text-3xl font-bold sm:text-4xl">{t("blog.title")}</h2>
        <p class="mt-2 max-w-md text-muted">{t("blog.lead")}</p>
      </div>
      <a href={path(lang, "blog")} class="hidden shrink-0 text-[15px] font-semibold underline-offset-4 hover:underline sm:block">{t("blog.back")}</a>
    </div>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.slice(0, 3).map((p, i) => <PostCard post={p} lang={lang} index={i} />)}
    </div>
  </section>
</Layout>

<style>
  .banner {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 1.75rem;
    isolation: isolate;
  }
  .banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0) 55%);
    z-index: 0;
  }
  .banner :global(.banner-img) {
    width: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .banner-label {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    color: white;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .banner-cta {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
    border-radius: 999px;
    background: white;
    color: var(--color-ink);
    padding: 0.5rem 0.9rem;
    font-size: 0.875rem;
    letter-spacing: 0;
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .banner:hover :global(.banner-img) {
      transform: scale(1.03);
    }
  }
  .banner:active .banner-cta {
    transform: scale(0.97);
  }

  /* Hero entrance: plays once on first paint (rare → allowed a little delight). */
  .hero-img {
    animation: hero-zoom 1400ms var(--ease-out) both;
  }
  .hero-in {
    animation: hero-in 700ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--d) * 70ms);
  }
  @keyframes hero-zoom {
    from { transform: scale(1.06); }
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-img { animation: none; }
    .hero-in { animation: hero-fade 400ms ease both; }
    @keyframes hero-fade { from { opacity: 0; } }
  }
</style>
