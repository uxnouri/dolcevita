---
import { Image, getImage } from "astro:assets";
import ShoppingBag from "@lucide/astro/icons/shopping-bag";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Star from "@lucide/astro/icons/star";
import Headset from "@lucide/astro/icons/headset";
import Ruler from "@lucide/astro/icons/ruler";
import Store from "@lucide/astro/icons/store";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import ProductCard from "../ProductCard.astro";
import { formatPrice, path, useT, type Lang } from "../../i18n";
import { colorLabel, discount, getCategory, primaryCategory, productImage, related, styleLabel, type Product } from "../../lib/catalog";
import { SITE } from "../../lib/site";

interface Props {
  lang: Lang;
  product: Product;
}
const { lang, product: p } = Astro.props;
const t = useT(lang);
const other: Lang = lang === "fr" ? "en" : "fr";
const images = p.images.map(productImage);
const cats = p.categories.map(getCategory).filter((c) => !!c);
const main = primaryCategory(p);
const off = discount(p);
const url = new URL(path(lang, "product", p.slug), Astro.site).href;
const thumb = await getImage({ src: images[0], width: 160, height: 160, format: "webp" });
const og = await getImage({ src: images[0], width: 1200, height: 1200, format: "jpg", background: "#ffffff" });
const waText = t("product.whatsappMessage", { name: p.name, url });
const money = (n: number) => formatPrice(n, lang, SITE.currency);

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.name,
  sku: p.sku ?? undefined,
  image: new URL(og.src, Astro.site).href,
  description: t("product.descriptionText"),
  brand: { "@type": "Brand", name: SITE.name },
  category: main?.label[lang],
  offers: {
    "@type": "Offer",
    url,
    priceCurrency: SITE.currency,
    price: p.price,
    availability: p.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
  },
  ...(p.rating > 0 && p.reviews > 0
    ? { aggregateRating: { "@type": "AggregateRating", ratingValue: p.rating, reviewCount: p.reviews } }
    : {}),
};

const crumbs = [
  { label: t("nav.home"), href: path(lang, "home") },
  { label: t("nav.shop"), href: path(lang, "shop") },
  ...(main ? [{ label: main.label[lang], href: path(lang, "category", main.slug) }] : []),
  { label: p.name },
];
---

<Layout
  lang={lang}
  title={p.name}
  description={`${p.name}. ${t("product.descriptionText")}`}
  alternate={path(other, "product", p.slug)}
  image={og.src}
  schema={[schema]}
>
  <div class="container-site pt-6 sm:pt-10">
    <Breadcrumbs items={crumbs} lang={lang} />

    <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:gap-14">
      <!-- Gallery -->
      <div class="lg:col-span-7" data-gallery>
        <div class="relative">
          <div class="rail gap-0! rounded-[1.75rem] bg-sand" data-gallery-rail style="scroll-padding-inline:0">
            {
              images.map((img, i) => (
                <div class="aspect-square w-full shrink-0">
                  <Image
                    src={img}
                    alt={i === 0 ? p.name : t("product.photo", { n: i + 1 })}
                    widths={[480, 720, 960, 1200]}
                    sizes="(min-width: 1024px) 55vw, 100vw"
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    class="size-full object-contain p-[6%] mix-blend-multiply"
                  />
                </div>
              ))
            }
          </div>
          <div class="absolute top-4 left-4 flex gap-1.5">
            {off > 0 && <span class="rounded-full bg-brand px-3 py-1 text-sm font-bold text-white">−{off}%</span>}
            {!p.inStock && <span class="rounded-full bg-ink px-3 py-1 text-sm font-bold text-white">{t("product.soldOut")}</span>}
          </div>
          {
            images.length > 1 && (
              <span class="absolute right-4 bottom-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold tabular-nums lg:hidden" data-gallery-counter>
                1 / {images.length}
              </span>
            )
          }
        </div>
        {
          images.length > 1 && (
            <div class="mt-3 flex gap-2 overflow-x-auto" role="group" aria-label="Photos">
              {images.map((img, i) => (
                <button
                  type="button"
                  data-gallery-thumb={i}
                  aria-label={t("product.photo", { n: i + 1 })}
                  aria-current={i === 0 ? "true" : undefined}
                  class="pressable size-16 shrink-0 overflow-hidden rounded-xl border-2 border-transparent bg-sand aria-[current=true]:border-ink sm:size-20"
                >
                  <Image src={img} alt="" width={160} height={160} class="size-full object-contain p-1 mix-blend-multiply" />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- Info -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          {main && <a href={path(lang, "category", main.slug)} class="eyebrow hover:text-ink">{main.label[lang]}</a>}
          <h1 class="mt-2 text-3xl font-bold sm:text-5xl">{p.name}</h1>

          {
            p.rating > 0 && (
              <p class="mt-3 flex items-center gap-1.5 text-sm text-muted">
                <span class="flex text-ink" aria-hidden="true">
                  {[1, 2, 3, 4, 5].map((n) => (
                    <Star size={15} fill={n <= Math.round(p.rating) ? "currentColor" : "none"} stroke-width={1.5} />
                  ))}
                </span>
                <span>{p.rating.toFixed(1)} {t("product.rating")}</span>
              </p>
            )
          }

          <p class="mt-5 flex items-baseline gap-3 tabular-nums">
            <span class:list={["text-3xl font-bold", off > 0 && "text-brand"]}>{money(p.price)}</span>
            {p.regularPrice && <s class="text-lg text-muted">{money(p.regularPrice)}</s>}
          </p>
          <p class:list={["mt-2 flex items-center gap-2 text-sm font-semibold", p.inStock ? "text-brand" : "text-sale"]}>
            <span class:list={["size-2 rounded-full", p.inStock ? "bg-brand" : "bg-sale"]}></span>
            {p.inStock ? t("product.inStock") : t("product.soldOut")}
          </p>

          {
            (p.colors.length > 0 || p.styles.length > 0) && (
              <dl class="mt-7 space-y-4 border-t border-ink/10 pt-6">
                {p.colors.length > 0 && (
                  <div>
                    <dt class="text-sm text-muted">{t("product.color")}</dt>
                    <dd class="mt-2 flex flex-wrap gap-2">
                      {p.colors.map((c) => (
                        <span class="rounded-full border border-ink/15 px-3 py-1.5 text-sm font-medium">{colorLabel(c, lang)}</span>
                      ))}
                    </dd>
                  </div>
                )}
                {p.styles.length > 0 && (
                  <div>
                    <dt class="text-sm text-muted">{t("product.style")}</dt>
                    <dd class="mt-2 flex flex-wrap gap-2">
                      {p.styles.map((s) => (
                        <span class="rounded-full border border-ink/15 px-3 py-1.5 text-sm font-medium">{styleLabel(s, lang)}</span>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>
            )
          }

          <div class="mt-8 grid gap-2.5">
            <button
              type="button"
              class="btn-primary h-14 w-full text-base disabled:pointer-events-none disabled:opacity-40"
              data-add-to-cart
              data-slug={p.slug}
              data-name={p.name}
              data-price={p.price}
              data-image={thumb.src}
              disabled={!p.inStock}
            >
              <ShoppingBag size={20} />
              {p.inStock ? t("product.add") : t("product.soldOut")}
            </button>
            <a
              href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(waText)}`}
              target="_blank"
              rel="noopener"
              class="btn-ghost h-14 w-full text-base"
            >
              <MessageCircle size={20} />
              {t("product.whatsapp")}
            </a>
          </div>

          <ul class="mt-8 space-y-3 rounded-2xl bg-sand p-5 text-[15px]">
            <li class="flex gap-3"><Headset size={20} class="shrink-0 text-brand" />{t("product.perks.advice")}</li>
            <li class="flex gap-3"><Ruler size={20} class="shrink-0 text-brand" />{t("product.perks.custom")}</li>
            <li class="flex gap-3"><Store size={20} class="shrink-0 text-brand" />{t("product.perks.showroom")}</li>
          </ul>

          <div class="mt-8">
            <h2 class="text-lg font-bold tracking-tight">{t("product.description")}</h2>
            <p class="mt-3 leading-relaxed text-muted">{t("product.descriptionText")}</p>
          </div>

          <dl class="mt-6 space-y-2 border-t border-ink/10 pt-5 text-sm">
            {p.sku && (
              <div class="flex gap-2"><dt class="text-muted">{t("product.sku")}</dt><dd class="font-medium">{p.sku}</dd></div>
            )}
            <div class="flex gap-2">
              <dt class="shrink-0 text-muted">{t("product.category")}</dt>
              <dd class="font-medium">
                {cats.map((c, i) => (
                  <>
                    {i > 0 && ", "}
                    <a href={path(lang, "category", c.slug)} class="underline-offset-4 hover:underline">{c.label[lang]}</a>
                  </>
                ))}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <section class="mt-24" aria-labelledby="related-title">
      <h2 id="related-title" class="text-3xl font-bold sm:text-4xl">{t("product.related")}</h2>
      <div class="mt-8 grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-5 lg:grid-cols-4">
        {related(p).map((r, i) => <ProductCard product={r} lang={lang} index={i} />)}
      </div>
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const rail = gallery.querySelector<HTMLElement>("[data-gallery-rail]")!;
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")];
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    const total = thumbs.length;

    thumbs.forEach((btn, i) =>
      btn.addEventListener("click", () => rail.scrollTo({ left: i * rail.clientWidth, behavior: "smooth" })),
    );

    let frame = 0;
    rail.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const i = Math.round(rail.scrollLeft / rail.clientWidth);
          thumbs.forEach((t, n) => (n === i ? t.setAttribute("aria-current", "true") : t.removeAttribute("aria-current")));
          if (counter) counter.textContent = `${i + 1} / ${total}`;
        });
      },
      { passive: true },
    );
  });
</script>
