---
import MapPin from "@lucide/astro/icons/map-pin";
import Phone from "@lucide/astro/icons/phone";
import Mail from "@lucide/astro/icons/mail";
import MessageCircle from "@lucide/astro/icons/message-circle";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import { path, useT, type Lang } from "../../i18n";
import { SITE, telHref } from "../../lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === "fr" ? "en" : "fr";
const field =
  "mt-2 block w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-base outline-none transition-[border-color,box-shadow] duration-150 focus:border-brand focus:ring-4 focus:ring-brand/15";
---

<Layout lang={lang} title={t("contact.title")} description={t("contact.lead")} alternate={path(other, "contact")}>
  <div class="container-site pt-6 sm:pt-10">
    <Breadcrumbs items={[{ label: t("nav.home"), href: path(lang, "home") }, { label: t("contact.title") }]} lang={lang} />
    <h1 class="mt-6 text-4xl font-bold sm:text-6xl">{t("contact.title")}</h1>
    <p class="mt-3 max-w-xl text-lg text-muted">{t("contact.lead")}</p>

    <div class="mt-12 grid gap-6 lg:grid-cols-12">
      <ul class="grid content-start gap-3 lg:col-span-5">
        <li>
          <a href={SITE.mapUrl} target="_blank" rel="noopener" class="pressable group flex gap-4 rounded-2xl bg-sand p-5 hover:bg-stone">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand text-white"><MapPin size={20} /></span>
            <span class="flex-1">
              <span class="block text-sm text-muted">{t("contact.address")}</span>
              <span class="mt-0.5 block font-semibold">{SITE.address.street}, {SITE.address.city}</span>
              <span class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-brand">{t("contact.map")}<ArrowUpRight size={14} /></span>
            </span>
          </a>
        </li>
        <li class="flex gap-4 rounded-2xl bg-sand p-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand text-white"><Phone size={20} /></span>
          <span>
            <span class="block text-sm text-muted">{t("contact.phone")}</span>
            {SITE.phones.map((p) => <a href={telHref(p)} class="mt-0.5 block font-semibold hover:text-brand">{p}</a>)}
          </span>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="pressable flex gap-4 rounded-2xl bg-sand p-5 hover:bg-stone">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand text-white"><Mail size={20} /></span>
            <span>
              <span class="block text-sm text-muted">{t("contact.email")}</span>
              <span class="mt-0.5 block font-semibold">{SITE.email}</span>
            </span>
          </a>
        </li>
      </ul>

      <form
        data-contact
        data-whatsapp={SITE.whatsapp}
        data-greeting={t("contact.form.greeting")}
        class="rounded-[1.75rem] border border-ink/10 bg-white p-6 sm:p-8 lg:col-span-7"
      >
        <h2 class="text-2xl font-bold">{t("contact.form.title")}</h2>
        <label class="mt-6 block text-sm font-semibold">
          {t("contact.form.name")}
          <input name="name" required autocomplete="name" class={field} />
        </label>
        <label class="mt-4 block text-sm font-semibold">
          {t("contact.form.message")}
          <textarea name="message" required rows="5" class={`${field} resize-y`}></textarea>
        </label>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <button type="submit" class="btn-primary"><MessageCircle size={18} />{t("contact.form.send")}</button>
          <a href={`mailto:${SITE.email}`} class="text-sm font-semibold text-muted underline-offset-4 hover:text-ink hover:underline">{t("contact.form.mail")}</a>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact]");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const greeting = form.dataset.greeting!.replace("{name}", String(data.get("name")).trim());
    const text = `${greeting}\n\n${String(data.get("message")).trim()}`;
    window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
  });
</script>
