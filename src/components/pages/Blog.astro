---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import PostCard from "../PostCard.astro";
import { alternates, path, useT, type Lang } from "../../i18n";
import { posts } from "../../lib/blog";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<Layout lang={lang} title={t("blog.title")} description={t("blog.lead")} alternates={alternates("blog")}>
  <div class="container-site pt-6 sm:pt-10">
    <Breadcrumbs items={[{ label: t("nav.home"), href: path(lang, "home") }, { label: t("blog.title") }]} lang={lang} />
    <h1 class="mt-6 text-4xl font-bold sm:text-6xl">{t("blog.title")}</h1>
    <p class="mt-3 max-w-xl text-lg text-muted">{t("blog.lead")}</p>
    <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => <PostCard post={p} lang={lang} index={i} />)}
    </div>
  </div>
</Layout>
