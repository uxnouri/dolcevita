---
import { Image, getImage } from "astro:assets";
import Plus from "@lucide/astro/icons/plus";
import { formatPrice, path, useT, type Lang } from "../i18n";
import { discount, oldPrice, primaryCategory, productImage, type Product } from "../lib/catalog";
import CategoryIcon from "./CategoryIcon.astro";
import { SITE } from "../lib/site";

interface Props {
  product: Product;
  lang: Lang;
  /** Responsive `sizes` hint, depends on the grid the card sits in. */
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { product: p, lang, sizes = "(min-width: 1280px) 22rem, (min-width: 768px) 30vw, 46vw", eager = false, class: className } = Astro.props;
const t = useT(lang);
// A product can be added before it's photographed: never let a missing image break the build.
const img = p.images[0] ? productImage(p.images[0]) : undefined;
const thumb = img ? await getImage({ src: img, width: 160, height: 160, format: "webp" }) : undefined;
const href = path(lang, "product", p.slug);
const off = discount(p);
const category = primaryCategory(p);
---

<article class:list={["group", className]}>
  <div class="relative">
  <a href={href} class="block" tabindex="-1" aria-hidden="true">
    <div class="relative aspect-square overflow-hidden rounded-2xl bg-sand transition-colors duration-150 ease-[ease] group-hover:bg-stone">
      {img ? (
        <Image
          src={img}
          alt=""
          widths={[240, 360, 520, 720]}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
          class="size-full object-contain p-[8%] mix-blend-multiply"
        />
      ) : (
        <span class="grid size-full place-items-center text-brand/40"><CategoryIcon slug={category?.slug ?? "canapes"} size={56} /></span>
      )}
      <div class="absolute start-3 top-3 flex gap-1.5">
        {off > 0 && <span dir="ltr" class="rounded-full bg-brand px-2.5 py-1 text-xs font-bold text-white tabular-nums">−{off}%</span>}
        {!p.inStock && <span class="rounded-full bg-ink px-2.5 py-1 text-xs font-bold text-white">{t("product.soldOut")}</span>}
      </div>
    </div>
  </a>

  {
    p.inStock && (
      <button
        type="button"
        class="pressable absolute end-3 bottom-3 grid size-11 place-items-center rounded-full bg-white text-ink shadow-[0_6px_20px_-6px_rgb(0_0_0/0.25)] hover:bg-ink hover:text-white"
        data-add-to-cart
        data-slug={p.slug}
        data-name={p.name}
        data-price={p.price}
        data-image={thumb?.src ?? ""}
        aria-label={`${t("product.add")} · ${p.name}`}
      >
        <Plus size={20} stroke-width={2} />
      </button>
    )
  }
  </div>

  <div class="mt-3 px-0.5">
    {category && <p class="text-xs text-muted">{category.label[lang]}</p>}
    <h3 class="mt-0.5 line-clamp-3 text-[15px] leading-snug font-semibold tracking-normal" title={p.name}>
      <a href={href} class="hover:text-brand">{p.name}</a>
    </h3>
    <p class="mt-1 flex flex-wrap items-baseline gap-x-2 text-[15px] tabular-nums">
      <span class:list={["font-bold whitespace-nowrap", off > 0 && "text-brand"]}>{formatPrice(p.price, lang, SITE.currency)}</span>
      {oldPrice(p) && <s class="text-sm whitespace-nowrap text-muted">{formatPrice(oldPrice(p)!, lang, SITE.currency)}</s>}
    </p>
  </div>
</article>
