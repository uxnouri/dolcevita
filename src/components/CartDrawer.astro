---
import X from "@lucide/astro/icons/x";
import ShoppingBag from "@lucide/astro/icons/shopping-bag";
import MessageCircle from "@lucide/astro/icons/message-circle";
import { path, useT, type Lang } from "../i18n";
import { SITE } from "../lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const config = {
  lang,
  currency: SITE.currency,
  whatsapp: SITE.whatsapp,
  productBase: path(lang, "product", "__slug__"),
  strings: {
    remove: t("cart.remove"),
    increase: t("cart.increase"),
    decrease: t("cart.decrease"),
    message: t("cart.message"),
    total: t("cart.total"),
  },
};
---

<dialog id="cart-drawer" class="sheet" aria-labelledby="cart-title" data-cart-config={JSON.stringify(config)}>
  <div class="flex h-full flex-col">
    <div class="flex h-16 items-center justify-between border-b border-ink/10 px-4 sm:px-6">
      <h2 id="cart-title" class="text-lg font-bold">{t("cart.title")}</h2>
      <button type="button" class="icon-btn -mr-2" data-close aria-label={t("nav.close")}><X size={22} /></button>
    </div>

    <div data-cart-empty class="flex flex-1 flex-col items-center justify-center gap-5 p-8 text-center">
      <div class="grid size-16 place-items-center rounded-full bg-sand text-muted">
        <ShoppingBag size={26} stroke-width={1.5} />
      </div>
      <p class="text-muted">{t("cart.empty")}</p>
      <a href={path(lang, "shop")} class="btn-primary">{t("cart.emptyCta")}</a>
    </div>

    <ul data-cart-items class="hidden flex-1 divide-y divide-ink/10 overflow-y-auto overscroll-contain px-4 sm:px-6"></ul>

    <div data-cart-footer class="hidden border-t border-ink/10 p-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:p-6">
      <div class="flex items-baseline justify-between">
        <span class="text-muted">{t("cart.total")}</span>
        <span data-cart-total class="text-xl font-bold tabular-nums"></span>
      </div>
      <a data-cart-checkout href="#" target="_blank" rel="noopener" class="btn-primary mt-4 w-full">
        <MessageCircle size={18} />
        {t("cart.checkout")}
      </a>
      <p class="mt-3 text-center text-xs leading-relaxed text-muted">{t("cart.note")}</p>
    </div>
  </div>
</dialog>
