---
/** TikTok glyph drawn like a Lucide icon (Lucide dropped brand icons). */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M15 3c.4 2.6 2.3 4.6 5 5v3.2a8.2 8.2 0 0 1-5-1.6V15a6 6 0 1 1-6-6v3.3A2.8 2.8 0 1 0 11.8 15V3z" />
</svg>
