---
import { Image } from "astro:assets";
import { formatDate, path, type Lang } from "../i18n";
import { blogImage } from "../lib/catalog";
import type { Post } from "../lib/blog";

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const href = path(lang, "blog", post.slug);
---

<article class="group">
  <a href={href} class="block overflow-hidden rounded-2xl bg-stone" tabindex="-1" aria-hidden="true">
    {
      post.image && (
        <Image
          src={blogImage(post.image)}
          alt=""
          widths={[400, 640, 880]}
          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
          class="aspect-[3/2] w-full object-cover transition-transform duration-250 ease-(--ease-out) group-hover:scale-[1.03] motion-reduce:transition-none"
        />
      )
    }
  </a>
  <time datetime={post.date} class="mt-4 block text-sm text-muted">{formatDate(post.date, lang)}</time>
  <h3 class="mt-1.5 text-xl leading-snug font-bold">
    <a href={href} class="hover:text-brand">{post.title[lang]}</a>
  </h3>
</article>
